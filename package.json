{
  "name": "@heybe/root",
  "version": "0.0.0",
  "description": "Heybe monorepo",
  "private": true,
  "license": "MIT",
  "author": "emresandikci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emresandikci/heybe.git"
  },
  "bugs": {
    "url": "https://github.com/emresandikci/heybe/issues"
  },
  "homepage": "https://github.com/emresandikci/heybe#readme",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "commit": "SKIP_COMMIT_CHECK=true git-cz",
    "release": "pnpm -r --sequential release",
    "prepare": "node .husky/install.mjs",
    "test:contract": "pnpm --filter heybe test:contract",
    "typecheck": "pnpm -r --filter ./packages/query --filter ./packages/heybe --filter ./packages/client --filter ./apps/dashboard exec tsc -p .",
    "test:e2e": "pnpm --filter @heybe/dashboard e2e",
    "bench": "pnpm --filter heybe bench",
    "smoke:binary": "pnpm --filter heybe smoke:binary",
    "test:client": "pnpm --filter @heybe/client test:integration",
    "smoke:node": "pnpm -r --filter ./packages/query --filter ./packages/client build && pnpm --filter @heybe/client exec node --input-type=module -e \"await import('@heybe/query'); await import('@heybe/client')\"  && pnpm --filter @heybe/client exec tsc -p smoke"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/commit-analyzer": "catalog:",
    "@semantic-release/git": "catalog:",
    "@semantic-release/npm": "catalog:",
    "@semantic-release/release-notes-generator": "catalog:",
    "@types/bun": "catalog:",
    "commitizen": "catalog:",
    "cz-conventional-changelog": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "semantic-release": "catalog:",
    "semantic-release-monorepo": "catalog:",
    "typescript": "catalog:"
  }
}
