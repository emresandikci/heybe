{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"],
    "skipLibCheck": true,
    "paths": {
      "@heybejs/client": ["../../packages/client/src/index.ts"],
      "@heybejs/query": ["../../packages/query/src/index.ts"],
      "@heybejs/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"]
}
