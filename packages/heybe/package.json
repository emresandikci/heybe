{
  "name": "heybe",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "exports": "./src/index.ts",
  "bin": {
    "heybe": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.fixture*.ts",
    "!src/import/pb-fixture.ts",
    "!src/**/testdata",
    "ui/dist"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "author": "emresandikci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emresandikci/heybe.git",
    "directory": "packages/heybe"
  },
  "scripts": {
    "release": "semantic-release -e semantic-release-monorepo",
    "test": "bun test src",
    "test:contract": "bun test ./contract/*.contract.ts",
    "bench": "bun bench/run.ts",
    "build:binary": "bun scripts/build-binary.ts",
    "smoke:binary": "bun scripts/smoke-binary.ts",
    "prepack": "pnpm --filter @heybe/dashboard build"
  },
  "devDependencies": {
    "@heybe/configs": "workspace:*",
    "@types/nodemailer": "^8.0.2",
    "autocannon": "catalog:"
  },
  "dependencies": {
    "@heybe/query": "workspace:^",
    "acme-client": "^5.4.0",
    "file-type": "^22.3.0",
    "nodemailer": "^10.4.0",
    "parse5": "^8.1.1",
    "sharp": "^0.35.5"
  }
}
